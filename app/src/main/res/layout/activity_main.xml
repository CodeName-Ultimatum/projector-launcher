<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg">

    <!--主内容区（正常层级）-->
    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--状态栏：以代码方式添加（无背景）-->
        <FrameLayout
            android:id="@+id/status_bar_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height" />

        <!--主内容区：左右上下各缩进36dp-->
        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="36dp"
            android:layout_marginRight="36dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="36dp"
            android:orientation="horizontal">

            <!--左侧 IVI 卡片占位容器：1/4 宽度，由代码创建 LauncherCardView-->
            <FrameLayout
                android:id="@+id/ivi_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!--右侧卡片网格：3/4 宽度-->
            <LinearLayout
                android:id="@+id/right_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical"
                android:padding="0dp">

                <!--上排：3 张卡片-->
                <LinearLayout
                    android:id="@+id/row_top"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />

                <!--中排：包含水平和垂直间隙-->
                <LinearLayout
                    android:id="@+id/row_middle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/card_gap_vertical"
                    android:layout_marginBottom="@dimen/card_gap_vertical" />

                <!--下排：3 张固定功能卡片-->
                <LinearLayout
                    android:id="@+id/row_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!--底部快捷栏：以代码方式添加（无背景）-->
        <FrameLayout
            android:id="@+id/quick_bar_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/quick_bar_height" />

    </LinearLayout>
</FrameLayout>
