<?xml version="1.0" encoding="utf-8"?>
<!--
    主布局文件 — TV Launcher 首页
    结构：FrameLayout（根）
        ├── LinearLayout（垂直，撑满全屏）
        │   ├── FrameLayout（状态栏容器，120dp）
        │   ├── LinearLayout（主内容区，weight=1，四周缩进36dp）
        │   │   ├── FrameLayout（IVI卡片容器，1/4宽）
        │   │   └── LinearLayout（右侧卡片网格，3/4宽）
        │   │       ├── row_top（上排3张竖卡，等权重）
        │   │       ├── row_middle（中排2张横卡，上下有8dp间隙）
        │   │       └── row_bottom（下排3张固定功能卡片）
        │   └── FrameLayout（快捷栏容器，140dp）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--外层垂直布局，将屏幕分为 状态栏 / 内容区 / 快捷栏 三段-->
    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!--
            状态栏容器
            实际内容由 StatusBarView 代码动态添加
            高度固定120dp，无背景颜色
        -->
        <FrameLayout
            android:id="@+id/status_bar_container"
            android:layout_width="match_parent"
            android:layout_height="60dp" />
<!--（状态栏高度 48dp→60dp，从内容区上边距移12dp过来）-->

        <!--
            主内容区 — IVI面板 + 卡片网格
            IVI 卡片（左1/4）由代码动态添加到 index=0
            右侧卡片网格（右3/4）跟随其后
        -->
        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="36dp"
            android:layout_marginRight="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!--
                右侧卡片网格（3/4）
                三行布局：上排3卡 / 中排2卡 / 下排3卡
                每行 height=0dp + weight=1 均分高度
            -->
            <LinearLayout
                android:id="@+id/right_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="0dp">

                <!--上排：3张竖卡（iconAbove模式下显示）-->
                <LinearLayout
                    android:id="@+id/row_top"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <!--中排：2张横卡（iconAbove=false），上下有8dp间隙-->
                <LinearLayout
                    android:id="@+id/row_middle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <!--下排：3张系统功能卡（应用列表/设置/文件管理）-->
                <LinearLayout
                    android:id="@+id/row_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!--
            快捷栏容器
            实际内容由 QuickBarView 代码动态添加
            高度固定140dp，水平滚动，无背景颜色
        -->
        <FrameLayout
            android:id="@+id/quick_bar_container"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</FrameLayout>
