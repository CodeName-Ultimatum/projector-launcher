<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@color/main_bg</item>
    </style>

    <!-- 文件管理器专属主题：独立于全局的深蓝背景，使用深色渐变背景
         必须同时覆盖 android:background 和 android:windowBackground，
         否则 AppCompat 用父主题继承的蓝色 android:background 涂装饰层盖住渐变 -->
    <style name="Theme.FileManager" parent="Theme.TVLauncher">
        <item name="android:background">@drawable/fm_background</item>
        <item name="android:windowBackground">@drawable/fm_background</item>
    </style>

    <!-- 深色对话框主题：透明窗口背景，深色面板，白色文字 -->
    <style name="DarkDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:colorAccent">#FF8E53</item>
        <item name="android:textColor">#F2F5F9</item>
        <item name="android:textColorPrimary">#F2F5F9</item>
        <item name="android:textColorSecondary">#8A94A6</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">70%</item>
        <item name="android:windowMinWidthMinor">70%</item>
    </style>

    <!-- 自定义应用选择对话框主题：完全透明窗口背景，无任何默认对话框绘制，仅显示深色面板 -->
    <style name="Theme.AppPickerDialog" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>
</resources>
