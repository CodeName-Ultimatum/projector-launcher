<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 背景改透明:不透明 main_bg 会被窗口装饰层继承并盖住 ThemeManager 动态设置的 screenColor。
             实际背景由 activity_main.xml 根布局持有,运行时由 ThemeManager 覆盖 -->
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 版本更新弹窗主题:浮动窗口 + 透明背景,圆角由内容布局 dialog_bg 绘制 -->
    <!-- 所有 window 级背景属性显式透明,防止从 Theme.TVLauncher 继承深蓝背景 -->
    <style name="DialogAppUpdateTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowBackgroundFallback">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundFloating">@android:color/transparent</item>
    </style>
</resources>
