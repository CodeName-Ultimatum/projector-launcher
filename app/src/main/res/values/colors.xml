<?xml version="1.0" encoding="utf-8"?>
<!--
    颜色定义文件
    命名规则：功能_属性_修饰（如 card_overlay_3_start 表示卡片3的渐变起始色）
    所有卡片覆盖层使用 #B3 前缀（70% alpha），确保背景图片可以透过约30%
-->
<resources>
    <color name="status_bar_bg">#CC1A1A2E</color>
    <!-- 页面底色：深蓝色（#000099） -->
    <color name="main_bg">#FF00008B</color>

    <!-- 主文字色：白色 -->
    <color name="text_primary">#FFFFFFFF</color>
    <!-- 副文字色：70%白色 -->
    <color name="text_secondary">#B3FFFFFF</color>

    <!-- ===== 卡片覆盖层颜色（alpha=70%即#B3，渐变明显，颜色明亮有区分度）===== -->

    <!-- card 0：珊瑚橙 → 蜜橙色 -->
    <color name="card_overlay_1_start">#B3FF6B6B</color>
    <color name="card_overlay_1_end">#B3FF8E53</color>

    <!-- card 1：电光紫 → 玫红 -->
    <color name="card_overlay_2_start">#B3E040FB</color>
    <color name="card_overlay_2_end">#B3FF4081</color>

    <!-- card 2：电光紫 → 玫红（与card1相同） -->
    <color name="card_overlay_3_start">#B3E040FB</color>
    <color name="card_overlay_3_end">#B3FF4081</color>

    <!-- card 3：明黄 → 暖橙 -->
    <color name="card_overlay_4_start">#B3FFD600</color>
    <color name="card_overlay_4_end">#B3FF6D00</color>

    <!-- card 4：明黄 → 琥珀 -->
    <color name="card_overlay_5_start">#B3FFD600</color>
    <color name="card_overlay_5_end">#B3FFAB00</color>

    <!-- card 5：翠绿 → 浅绿 -->
    <color name="card_overlay_6_start">#B300FA9A</color>
    <color name="card_overlay_6_end">#B398FB98</color>

    <!-- card 6：明黄 → 暖橙（与card3相同） -->
    <color name="card_overlay_7_start">#B3FFD600</color>
    <color name="card_overlay_7_end">#B3FF6D00</color>

    <!-- card 7：电光紫 → 玫红（与card1相同） -->
    <color name="card_overlay_8_start">#B3E040FB</color>
    <color name="card_overlay_8_end">#B3FF4081</color>

    <!-- 快捷栏背景 -->
    <color name="quick_bar_bg">#CC0D1117</color>
    <!-- 添加按钮背景 -->
    <color name="add_button_bg">#33334455</color>
    <!-- 卡片聚焦白色边框 -->
    <color name="card_focused_border">#FFFFFFFF</color>

    <!-- IVI面板：珊瑚橙 → 蜜橙渐变 -->
    <color name="ivi_overlay_start">#B3FF6B6B</color>
    <color name="ivi_overlay_end">#B3FF8E53</color>

    <!-- WiFi断开连接图标着色：40%白色 -->
    <color name="wifi_icon_disconnected">#66FFFFFF</color>
    <!-- 状态栏浅色背景（备用） -->
    <color name="status_bar_bg_light">#FFFFFFFF</color>
</resources>
